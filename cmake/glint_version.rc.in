#include <windows.h>

1 RT_MANIFEST "@GLINT_GENERATED_MANIFEST@"

1 VERSIONINFO
FILEVERSION @GLINT_VERSION_MAJOR@,@GLINT_VERSION_MINOR@,@GLINT_VERSION_PATCH@,0
PRODUCTVERSION @GLINT_VERSION_MAJOR@,@GLINT_VERSION_MINOR@,@GLINT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Glint browser tab search"
      VALUE "FileVersion", "@GLINT_FILE_VERSION@"
      VALUE "InternalName", "Glint"
      VALUE "OriginalFilename", "Glint.exe"
      VALUE "ProductName", "Glint"
      VALUE "ProductVersion", "@GLINT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
