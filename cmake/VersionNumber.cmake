include_guard(GLOBAL)

# All Windows VERSIONINFO and assembly identity components are unsigned words.
function(glint_parse_version value prefix)
  if(NOT "${value}" MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Glint version must be major.minor.patch with canonical nonnegative integers: '${value}'")
  endif()
  set(components "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3}")
  foreach(component IN LISTS components)
    string(LENGTH "${component}" length)
    if(length GREATER 5 OR component GREATER 65535)
      message(FATAL_ERROR "Glint version component is outside the Windows range 0..65535: '${value}'")
    endif()
  endforeach()
  list(GET components 0 major)
  list(GET components 1 minor)
  list(GET components 2 patch)
  set(${prefix} "${value}" PARENT_SCOPE)
  set(${prefix}_MAJOR "${major}" PARENT_SCOPE)
  set(${prefix}_MINOR "${minor}" PARENT_SCOPE)
  set(${prefix}_PATCH "${patch}" PARENT_SCOPE)
endfunction()

function(glint_read_version path prefix)
  file(READ "${path}" value)
  string(STRIP "${value}" value)
  glint_parse_version("${value}" parsed)
  foreach(suffix IN ITEMS "" _MAJOR _MINOR _PATCH)
    set(${prefix}${suffix} "${parsed${suffix}}" PARENT_SCOPE)
  endforeach()
endfunction()
